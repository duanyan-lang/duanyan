{
  "name": "@duanyan-lang/duanyan",
  "version": "1.7.0",
  "description": "DUANYAN: JavaScript/TypeScript → Native Code → ESP32 / Arduino / STM32 / Raspberry Pi unified hardware programming compiler",
  "keywords": [
    "compiler",
    "embedded",
    "esp32",
    "arduino",
    "stm32",
    "risc-v",
    "iot",
    "hardware",
    "javascript",
    "typescript",
    "firmware"
  ],
  "homepage": "https://github.com/duanyan-lang/duanyan",
  "repository": {
    "type": "git",
    "url": "https://github.com/duanyan-lang/duanyan.git"
  },
  "bugs": {
    "url": "https://github.com/duanyan-lang/duanyan/issues"
  },
  "author": {
    "name": "duanyan-lang",
    "email": "duanyan1649@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "duanyan": "./bin/duanyan.js"
  },
  "files": [
    "bin/duanyan.js",
    "scripts/install.js",
    "scripts/platforms.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js",

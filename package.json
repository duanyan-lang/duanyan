    "test": "cargo test --locked",
    "build:platform": "node scripts/build-platform-package.js"
  },
  "optionalDependencies": {
    "@duanyan-lang/duanyan-win32-x64": "1.7.0",
    "@duanyan-lang/duanyan-win32-arm64": "1.7.0",
    "@duanyan-lang/duanyan-linux-x64": "1.7.0",
    "@duanyan-lang/duanyan-linux-arm64": "1.7.0",
    "@duanyan-lang/duanyan-darwin-x64": "1.7.0",
    "@duanyan-lang/duanyan-darwin-arm64": "1.7.0"
  },
  "engines": {
    "node": ">=16"
  },
  "os": ["win32", "linux", "darwin"],
  "cpu": ["x64", "arm64"]
}
